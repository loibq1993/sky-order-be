# Application Configuration
PORT=4500
NODE_ENV=development

# Superadmin seed (optional – for yarn seed:superadmin)
# SUPERADMIN_USERNAME=superadmin
# SUPERADMIN_PASSWORD=admin123
# SUPERADMIN_EMAIL=superadmin@skyorder.com

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_DATABASE=sky_order

# CORS Configuration
# CORS_ORIGIN_FROM_DB=true: chỉ cho phép Origin trong CORS_ORIGIN (full URL) + Origin khớp public.tenants.customDomain (tenant đang active).
# false (mặc định): HTTP dùng reflect mọi Origin (như trước).
CORS_ORIGIN_FROM_DB=false
# Làm mới cache domain tenant (ms)
CORS_ORIGIN_CACHE_TTL_MS=60000
# Danh sách Origin tĩnh (full URL, phân tách bằng dấu phẩy): admin nền tảng, localhost dev, v.v. — luôn merge khi bật CORS_ORIGIN_FROM_DB.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Comma-separated list of allowed HTTP methods
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS

# Comma-separated list of allowed headers
CORS_ALLOWED_HEADERS=Content-Type,Authorization,Accept,X-Tenant-Domain,x-tenant-domain

# Enable credentials (cookies, authorization headers)
CORS_CREDENTIALS=true

# Swagger Configuration
SWAGGER_TITLE=Sky Order API
SWAGGER_DESCRIPTION=Food ordering system API with categories and menu items management
SWAGGER_VERSION=1.0
SWAGGER_PATH=api/docs

# Logging Configuration
LOG_LEVEL=debug
LOG_FORMAT=combined

# Security Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Stripe Payment (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
# Bắt buộc local: chỉ webhook mới đổi đơn sang paid (sync /payment/success chỉ poll DB).
# stripe listen --forward-to localhost:4500/api/payments/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=vnd
# Customer redirect URLs after Checkout (no trailing slash)
FRONTEND_URL=http://localhost:3000